# Шаблон секретов для Kubernetes. Настоящий файл secrets.env рядом создаёт
#   python lab3/scripts/make_secrets.py
# из lab2/.env (те же пароли, что в docker compose). secrets.env в Git не попадает (.gitignore).
# kustomize (kubectl apply -k) превращает этот файл в объект Secret pad-secrets
# (см. secretGenerator в kustomization.yaml).
POSTGRES_PASSWORD=change-me
AUTH_DB_PASSWORD=change-me
CATALOG_DB_PASSWORD=change-me
INVENTORY_DB_PASSWORD=change-me
ORDER_DB_PASSWORD=change-me
FULFILLMENT_DB_PASSWORD=change-me
NOTIFICATION_DB_PASSWORD=change-me
RABBITMQ_USER=warehouse
RABBITMQ_PASSWORD=change-me
ADMIN_PASSWORD=change-me
# Закрытый ключ RSA для подписи JWT одной строкой (переводы строк заменены на \n).
# В Kubernetes он обязателен: у двух копий auth-service должен быть один и тот же ключ.
JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
