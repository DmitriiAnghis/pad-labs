# Copy to .env and adjust:  Copy-Item .env.example .env
# .env is in .gitignore: secrets never go to Git.

# --- Paths ---
# DATA_DIR=data
# RAG_CONFIG=configs/default.yaml

# --- Ollama (LLM + optional embeddings) ---
# Your home PC address (e.g. Tailscale IP) or localhost
OLLAMA_URL=http://localhost:11434
# Main generation model (check exact tag with `ollama list`)
LLM_MODEL=qwen3.5:4b
# Second model for the LLM comparison experiment
LLM_MODEL_ALT=qwen3.5:9b
# Model used as LLM-as-a-judge in evaluation (ideally different from LLM_MODEL)
JUDGE_MODEL=qwen3.5:9b
# Embedding model served by Ollama (used when embedding.backend=ollama)
EMBED_MODEL=bge-m3
# Seconds before an Ollama request is aborted
OLLAMA_TIMEOUT=180
LLM_TEMPERATURE=0
LLM_NUM_CTX=8192
# Thinking mode for reasoning models: true / false / empty (= do not send the flag)
LLM_THINK=false

# --- Reranker (cross-encoder, downloaded from huggingface.co on first use) ---
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# --- Source (grabber) ---
SOURCE_REPO_URL=https://github.com/odoo/documentation.git
SOURCE_BRANCH=18.0

# --- API ---
API_HOST=127.0.0.1
API_PORT=8000

# --- Logging ---
LOG_LEVEL=INFO
# json (for services / labs 2-3) or text (for humans)
LOG_FORMAT=text
