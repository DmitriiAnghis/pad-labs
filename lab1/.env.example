# Локальные настройки окружения: адреса, модели, порты.
# Это шаблон: скопируй в .env и поменяй значения под свою машину:
#   Copy-Item .env.example .env
# .env в .gitignore и в Git не попадает, поэтому секреты храним только там.
# Формат: ИМЯ=значение. Строки с # не читаются.

# --- Пути ---
# DATA_DIR=data                       # папка с данными (скачанные статьи, индексы); по умолчанию lab1/data
# RAG_CONFIG=configs/default.yaml     # файл основной конфигурации пайплайна

# --- Ollama (сервер, который запускает LLM и, при необходимости, модель эмбеддингов) ---
# Адрес Ollama. localhost — этот компьютер; через SSH-туннель запросы идут на домашний ПК
OLLAMA_URL=http://localhost:11434
# Основная LLM для ответов (точное имя — в выводе `ollama list`)
LLM_MODEL=qwen3.5:4b
# Вторая LLM для эксперимента по сравнению моделей
LLM_MODEL_ALT=qwen3.5:9b
# LLM-оценщик (LLM-as-a-judge) для экспериментов; желательно отличается от LLM_MODEL
JUDGE_MODEL=qwen3.5:9b
# Модель эмбеддингов в Ollama, понимает русский; используется при embedding.backend=ollama
EMBED_MODEL=bge-m3
# Таймаут запроса к Ollama в секундах
OLLAMA_TIMEOUT=180
# Температура генерации: 0 — без случайности, одинаковый ответ на одинаковый вопрос
LLM_TEMPERATURE=0
# Размер контекстного окна LLM в токенах (сколько текста модель видит за один запрос)
LLM_NUM_CTX=8192
# Режим рассуждений для reasoning-моделей: true / false / пусто (не передавать). false — быстрее
LLM_THINK=false

# --- Reranker на cross-encoder (скачивается с huggingface.co при первом использовании) ---
# Используется при reranker.backend=cross_encoder
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# --- Источник документации (команда grab) ---
# Git-репозиторий документации Odoo
SOURCE_REPO_URL=https://github.com/odoo/documentation.git
# Ветка = версия документации (18.0 — Odoo 18)
SOURCE_BRANCH=18.0

# --- API (команда serve) ---
# Адрес и порт веб-сервера: http://127.0.0.1:8000
API_HOST=127.0.0.1
API_PORT=8000

# --- Langfuse (трассировка: запись каждого шага ответа, просмотр в браузере) ---
# Без ключей Langfuse выключен: трасса всё равно показывается на сайте под ответом, но никуда не отправляется.
# Если Langfuse недоступен, ответы работают как обычно, в логе будет только предупреждение.
# Адрес Langfuse. Локальный (Docker, папка PAD\langfuse): http://localhost:3000. Облако: https://cloud.langfuse.com
LANGFUSE_HOST=http://localhost:3000
# Ключи проекта Langfuse (Settings -> API Keys или LANGFUSE_INIT_PROJECT_* в .env Langfuse). Только здесь, не в Git
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- Логи ---
# Уровень: DEBUG — подробно, INFO — обычные сообщения, WARNING — только проблемы
LOG_LEVEL=INFO
# Формат: text — для чтения человеком, json — для сбора логов сервисами (лабы 2-3)
LOG_FORMAT=text
