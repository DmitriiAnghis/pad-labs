# Личные настройки: ОТКУДА брать данные и С КЕМ говорить (адреса, модели).
# Это образец. Скопируй его в файл .env и поменяй значения под себя:
#   Copy-Item .env.example .env
# Файл .env на GitHub не попадает (он в .gitignore), поэтому сюда можно писать пароли.
# Формат: ИМЯ=значение. Строки с # программа не читает.

# --- Папки ---
# DATA_DIR=data                       # куда класть скачанные статьи и индекс (по умолчанию lab1/data)
# RAG_CONFIG=configs/default.yaml     # какой файл главных настроек читать

# --- Нейросеть (Ollama = программа, которая запускает нейросети) ---
# Адрес Ollama. localhost = этот компьютер; через SSH-туннель запрос уходит на домашний ПК
OLLAMA_URL=http://localhost:11434
# Нейросеть, которая пишет ответы (точное имя смотри командой `ollama list`)
LLM_MODEL=qwen3.5:4b
# Вторая нейросеть — только для эксперимента "какая модель лучше"
LLM_MODEL_ALT=qwen3.5:9b
# Нейросеть-проверяющий: ставит оценки ответам в экспериментах (лучше другая, чем LLM_MODEL)
JUDGE_MODEL=qwen3.5:9b
# Модель "текст -> числа" через Ollama, понимает и русский (включается, если в default.yaml embedding.backend=ollama)
EMBED_MODEL=bge-m3
# Сколько секунд ждать ответа нейросети, потом сдаться
OLLAMA_TIMEOUT=180
# "Фантазия" нейросети: 0 = без фантазии, на один вопрос всегда один ответ
LLM_TEMPERATURE=0
# Сколько текста нейросеть читает за раз (примерно 6 страниц)
LLM_NUM_CTX=8192
# Режим "думать вслух" перед ответом: true / false / пусто (= не передавать). false = быстрее
LLM_THINK=false

# --- Перепроверка точной моделью (скачивается с huggingface.co при первом запуске) ---
# Используется, только если в default.yaml reranker.backend=cross_encoder
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# --- Откуда скачивать документацию (команда grab) ---
# Адрес документации Odoo на GitHub
SOURCE_REPO_URL=https://github.com/odoo/documentation.git
# Ветка = версия документации: 18.0 = Odoo 18
SOURCE_BRANCH=18.0

# --- Сайт (команда serve) ---
# Адрес и порт сайта: получится http://127.0.0.1:8000
API_HOST=127.0.0.1
API_PORT=8000

# --- Сообщения в консоли ---
# Сколько писать: DEBUG = всё подряд, INFO = обычные сообщения, WARNING = только проблемы
LOG_LEVEL=INFO
# text = понятным текстом для человека, json = для программ (пригодится в лабах 2-3)
LOG_FORMAT=text
