# Шаблон секретов для docker compose. Сам файл .env в Git не попадает (.gitignore).
# Быстрый способ: python scripts/init_env.py  -> создаст .env со случайными паролями и ключом JWT.

# --- PostgreSQL: пароль суперпользователя и по паролю на базу каждого сервиса ---
POSTGRES_PASSWORD=change-me
AUTH_DB_PASSWORD=change-me
CATALOG_DB_PASSWORD=change-me
INVENTORY_DB_PASSWORD=change-me
ORDER_DB_PASSWORD=change-me
FULFILLMENT_DB_PASSWORD=change-me
NOTIFICATION_DB_PASSWORD=change-me

# --- RabbitMQ ---
RABBITMQ_USER=warehouse
RABBITMQ_PASSWORD=change-me

# --- auth-service ---
# Пароль первого администратора (логин admin), создаётся при первом запуске.
ADMIN_PASSWORD=change-me
# Закрытый ключ RSA для подписи JWT, одной строкой, переводы строк заменены на \n.
# Пусто = auth-service сгенерирует временный ключ при старте (только для разработки).
JWT_PRIVATE_KEY=

# --- RAG (лаба 1) ---
# Ollama на HOME-PC через SSH-туннель на этом компьютере (ssh -N -L 11434:localhost:11434 homepc).
# Из контейнера компьютер виден как host.docker.internal.
OLLAMA_URL=http://host.docker.internal:11434
LLM_MODEL=qwen3.5:9b

# --- общее ---
LOG_LEVEL=INFO
